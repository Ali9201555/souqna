# Souqna environment variables — copy this file to `.env` and fill in real values.
# Never commit `.env` (it is git-ignored). `EXPO_PUBLIC_*` vars are inlined into
# the JS bundle at build time, so only put publishable (client-safe) values here.
#
# Get these from your Supabase project: Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
